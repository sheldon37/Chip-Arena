{
  "name": "chip-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node --import tsx scripts/generate-icons.mjs && node scripts/generate-build-info.mjs && tsc --noEmit && node scripts/clean-build.mjs && vite build && node scripts/package-source.mjs && node scripts/build-relay.mjs && node scripts/package-update.mjs",
    "server": "node --import tsx src/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "start": "node server-dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:network": "node --import tsx tests/network.ts",
    "test:network:local": "node tests/run-network.mjs",
    "test:debris": "node tests/run-network.mjs debris",
    "test:stress": "node --import tsx tests/stress.ts",
    "audio:generate": "node scripts/generate-audio.mjs",
    "test:elements:network": "node tests/run-network.mjs elements",
    "test:block:network": "node tests/run-network.mjs block",
    "db:generate": "drizzle-kit generate",
    "test:https": "node --import tsx tests/https-network.ts",
    "test:pve-perf": "node --import tsx tests/pve-perf.ts",
    "test:pve-balance": "node --import tsx tests/pve-balance.ts",
    "test:motion:network": "node tests/run-network.mjs motion",
    "package:windows": "node scripts/package-windows.mjs",
    "music:generate": "node scripts/generate-music.mjs",
    "icons:generate": "node --import tsx scripts/generate-icons.mjs",
    "setup": "npm ci --no-audit --no-fund",
    "check:types": "tsc --noEmit",
    "build:check": "node --import tsx scripts/generate-icons.mjs && node scripts/generate-build-info.mjs && tsc --noEmit && node scripts/clean-build.mjs && vite build && node scripts/build-relay.mjs && npm run server:build",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify": "node scripts/verify.mjs full",
    "release:prepare": "npm run build",
    "runtime:fetch": "node scripts/fetch-runtimes.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "verify:standard": "node scripts/verify.mjs standard"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@noble/hashes": "2.0.1",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.12",
    "lucide-static": "1.48.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "packageManager": "npm@11.9.0"
}
