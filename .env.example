# Persistent Node server. No secrets are required.
PORT=8788
# Comma-separated allowed browser origins. Empty permits all origins for local prototyping.
# Set explicit origins before making a server public. These are examples, not a deployed backend.
ALLOWED_ORIGINS=http://localhost:8788,http://localhost:4173
# Only enable deliberately for private test servers. The creating room owner must also opt in.
ALLOW_TEST_ROOMS=false
# Optional: build-time default endpoint for the advanced dedicated-server option.
# VITE_SERVER_URL=wss://your-server.example/socket

# Default rooms use same-origin /api/rooms. Sites supplies an isolated DB binding.
# No TURN, PeerJS, ChatGPT login or provider key is required.

# Sites runtime variable, set only after deploying the persistent Node backend.
# Automatically routes Create/Join/invites; players never enter this address.
# MULTIPLAYER_URL=wss://your-backend.example/socket

# Existing hosted identity service secret NAMES only (configure in provider stores).
# DEV_SIGNING_KEY=<private ECDSA P-256 JWK; never ship to client or repository>
# DEV_ACCOUNT_VERIFIER=<legacy developer account verifier; never commit>
# Local relay tests create throwaway keys/databases in memory.
